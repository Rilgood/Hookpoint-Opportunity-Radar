{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "verify:api-contract": "sh ./scripts/verify-api-contract.sh",
    "verify:api-server": "sh ./scripts/verify-api-server.sh",
    "verify:radar-core": "sh ./scripts/verify-radar-core.sh",
    "verify:browser-smoke": "sh ./scripts/with-generated-api-lock.sh pnpm --filter @workspace/scripts run browser-smoke",
    "verify:release": "sh ./scripts/verify-release.sh",
    "db:restore-rehearsal": "bash ./scripts/radar-restore-rehearsal.sh",
    "db:restore-rehearsal:test": "bash ./scripts/radar-restore-rehearsal.test.sh",
    "demo": "node scripts/local-demo.mjs",
    "preflight:production": "node scripts/production-preflight.mjs",
    "verify:production-preflight": "node --test scripts/production-preflight.test.mjs",
    "verify:production-rehearsal": "node scripts/production-rehearsal.mjs"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vitest": "^5.0.0"
  }
}

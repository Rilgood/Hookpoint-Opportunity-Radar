# Deployment template only. Copy to .env.production for an explicitly local
# preflight, or provision these fields through the deployment secret manager.
# No credentials are included. Empty required fields intentionally fail preflight.
# Provider credentials can be connected after the application gates pass.
NODE_ENV=production
PORT=8080
AUTH_REQUIRED=true
HOOKPOINT_LOCAL_DEMO=false
VITE_LOCAL_DEMO=false

# Independent random values, at least 32 characters each.
# ADMIN_API_KEY bootstraps the default integration tenant; never expose it to Vite.
HASH_SALT=
ADMIN_API_KEY=
DEFAULT_TENANT_ID=tenant_hookpoint

# Production Clerk instance. Both publishable keys must target that instance.
# Only VITE_CLERK_PUBLISHABLE_KEY is included in the public browser build.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
# Optional when the deployment supplies a Clerk proxy:
VITE_CLERK_PROXY_URL=
BASE_PATH=/

# Comma-separated exact HTTPS origins, without paths or trailing slashes.
ALLOWED_ORIGINS=
# Enable only behind an ingress that replaces untrusted forwarded headers.
TRUST_PROXY=false

# Managed PostgreSQL connection URL with the provider's verified TLS settings.
# The app uses its own radar schema, apart from the Drizzle public schema.
DATABASE_URL=
RADAR_DB_SCHEMA=radar
DB_STATEMENT_TIMEOUT_MS=30000
# SQLite is only an alternative on an explicitly persistent single host.
# Use an absolute path and verified backups if choosing that topology.
DATABASE_PATH=
ALLOW_EPHEMERAL_STORAGE=false
DURABLE_STORAGE_CONFIRMED=false

# Scheduling needs an awake API instance; scale-to-zero is not a precise clock.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=60000
CONNECTOR_TIMEOUT_MS=45000
CONNECTOR_LEASE_MS=300000
CONNECTOR_MAX_RECORDS=5000
RESCORE_BATCH_SIZE=500
MAX_BODY_BYTES=5000000
MAX_BATCH_RECORDS=5000
MAX_EXPORT_ROWS=50000
MAX_FUTURE_SKEW_MINUTES=60
RATE_LIMIT_PER_MINUTE=600
LOG_LEVEL=info

# Optional until a webhook source is connected; use 32+ independent characters.
CONNECTOR_WEBHOOK_SECRET=
